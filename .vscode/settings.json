{
  // uv puts the environment in .venv.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // The Python Environments extension owns interpreter selection when it is
  // installed, and `python.defaultInterpreterPath` alone will not move it. It
  // scans workspaceSearchPaths on activation, so a .venv created after the
  // folder was opened is only picked up on the next window reload.
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python-envs.workspaceSearchPaths": [".venv"],
  "python-envs.alwaysUseUv": true,

  // basedpyright is the language server (Pylance is not on Open VSX), but it
  // does not type-check: CI runs `mypy --strict`, and two checkers with
  // different strictness models disagreeing in the gutter is worse than one.
  // basedpyright still provides completion, hover, go-to-definition and rename.
  "python.languageServer": "None",
  "basedpyright.analysis.typeCheckingMode": "off",
  "basedpyright.analysis.autoImportCompletions": true,

  // Both default to a bundled copy that cannot see the project's dependencies,
  // so their results drift from what CI runs. Point them at the venv.
  "ruff.importStrategy": "fromEnvironment",
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.args": ["--strict"],
  "mypy-type-checker.reportingScope": "workspace",

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },

  // Format Document needs a formatter per language, not one global default.
  // Python goes to ruff so the editor and CI agree; the rest go to prettier.
  "[json]":     { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]":    { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]":     { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[toml]":     { "editor.formatOnSave": false },

  // SQL has no formatter on purpose. The column alignment in
  // db/migrations/0001_events.sql is deliberate and every SQL formatter worth
  // installing would destroy it.
  "[sql]": { "editor.formatOnSave": false },

  "files.exclude": { "**/__pycache__": true },
  "search.exclude": { "**/.venv": true, "tmp/audit/data": true }
}
